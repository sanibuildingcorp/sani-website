<script>
function handleSearch(e) {
  e.preventDefault();
  const query = document.getElementById('search-input').value.trim().toLowerCase();
  if (!query) return;

  // Map common search terms to actual pages
  const routes = {
    'bathroom': '/bathroom-renovation',
    'tub': '/bathroom-renovation',
    'shower': '/bathroom-renovation',
    'tile': '/bathroom-floor-tile-installation',
    'kitchen': '/kitchen-renovation',
    'cabinet': '/kitchen-renovation',
    'paint': '/painting',
    'painting': '/painting',
    'floor': '/flooring',
    'flooring': '/flooring',
    'hardwood': '/flooring',
    'carpentry': '/carpentry',
    'wood': '/carpentry',
    'water': '/water-damage',
    'damage': '/water-damage',
    'leak': '/water-damage',
    'handyman': '/handyman',
    'repair': '/handyman',
    'gallery': '/gallery',
    'project': '/gallery',
    'photo': '/gallery',
    'contact': '/contact',
    'phone': '/contact',
    'estimate': '/estimate',
    'quote': '/estimate',
    'price': '/estimate',
    'cost': '/estimate',
    'about': '/about',
    'deck': '/deck-renovation',
    'stair': '/stair-renovation',
    'brooklyn': '/renovation-contractor-brooklyn',
    'manhattan': '/renovation-contractor-manhattan',
    'queens': '/renovation-contractor-queens',
    'bronx': '/renovation-contractor-bronx',
    'staten': '/renovation-contractor-staten-island',
    'long island': '/renovation-contractor-long-island'
  };

  // Find best match
  for (const [keyword, route] of Object.entries(routes)) {
    if (query.includes(keyword)) {
      window.location.href = route;
      return;
    }
  }

  // No match — go to services page
  window.location.href = '/services';
}
</script>

