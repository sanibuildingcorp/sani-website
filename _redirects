<style>
* { margin: 0; padding: 0; box-sizing: border-box; }
:root {
  --gold: #c8860a;
  --gold-light: #f0a500;
  --gold-bright: #ffb627;
  --navy: #0a1628;
  --navy-deep: #050d1a;
  --navy-light: #1a2940;
  --white: #fff;
  --text-muted: rgba(255, 255, 255, 0.55);
  --text-soft: rgba(255, 255, 255, 0.75);
  --border-soft: rgba(240, 165, 0, 0.18);
  --glass: rgba(255, 255, 255, 0.04);
  --glass-hover: rgba(255, 255, 255, 0.07);
}
html { scroll-behavior: smooth; }
body {
  font-family: 'DM Sans', -apple-system, sans-serif;
  background: var(--navy-deep);
  color: var(--white);
  min-height: 100vh;
  -webkit-font-smoothing: antialiased;
  display: flex;
  flex-direction: column;
}

/* ═══════════ NAV ═══════════ */
nav {
  position: sticky;
  top: 0;
  background: rgba(10, 22, 40, 0.95);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border-bottom: 1px solid var(--border-soft);
  z-index: 100;
}
.nav-inner {
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 24px;
  height: 64px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.nav-logo {
  text-decoration: none;
  display: flex;
  flex-direction: column;
  line-height: 1.1;
}
.nav-logo .brand {
  font-family: 'Playfair Display', serif;
  font-size: 16px;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2px;
  text-transform: uppercase;
}
.nav-logo .brand span {
  color: var(--gold-light);
}
.nav-logo .sub {
  font-size: 9px;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.4);
  margin-top: 2px;
}
.nav-cta {
  background: var(--gold);
  color: #fff;
  padding: 9px 20px;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  text-decoration: none;
  border-radius: 4px;
  transition: background 0.2s;
}
.nav-cta:hover { background: var(--gold-light); }

/* ═══════════ HERO 404 ═══════════ */
.hero-404 {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60px 24px 80px;
  position: relative;
  overflow: hidden;
}

/* Subtle grid background */
.hero-404::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(240, 165, 0, 0.04) 1px, transparent 1px),
    linear-gradient(90deg, rgba(240, 165, 0, 0.04) 1px, transparent 1px);
  background-size: 48px 48px;
  pointer-events: none;
}
/* Subtle gold glow */
.hero-404::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 600px;
  height: 600px;
  background: radial-gradient(circle, rgba(240, 165, 0, 0.08) 0%, transparent 65%);
  pointer-events: none;
  z-index: 0;
}

.hero-content {
  position: relative;
  z-index: 1;
  max-width: 760px;
  width: 100%;
  text-align: center;
}

.error-badge {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 8px 18px;
  background: var(--glass);
  border: 1px solid var(--border-soft);
  border-radius: 100px;
  font-size: 11px;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 28px;
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}
.error-badge .dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--gold);
  animation: pulse-dot 2s ease-in-out infinite;
}
@keyframes pulse-dot {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.5; transform: scale(1.3); }
}

.error-num {
  font-family: 'Playfair Display', serif;
  font-size: clamp(120px, 18vw, 200px);
  font-weight: 900;
  line-height: 0.9;
  background: linear-gradient(135deg, var(--gold-bright) 0%, var(--gold) 50%, #8a5a07 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  margin-bottom: 12px;
  letter-spacing: -4px;
}

h1 {
  font-family: 'Playfair Display', serif;
  font-size: clamp(28px, 4vw, 42px);
  font-weight: 700;
  color: #fff;
  margin-bottom: 14px;
  line-height: 1.15;
}
h1 em {
  font-style: italic;
  color: var(--gold-light);
}

.hero-text {
  font-size: 16px;
  color: var(--text-soft);
  max-width: 520px;
  margin: 0 auto 36px;
  line-height: 1.6;
}

/* ═══════════ SEARCH BOX ═══════════ */
.search-wrap {
  max-width: 480px;
  margin: 0 auto 36px;
  position: relative;
}
.search-input {
  width: 100%;
  background: var(--glass);
  border: 1.5px solid var(--border-soft);
  color: #fff;
  padding: 16px 50px 16px 20px;
  font-family: inherit;
  font-size: 15px;
  border-radius: 8px;
  transition: all 0.2s;
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}
.search-input::placeholder { color: rgba(255, 255, 255, 0.4); }
.search-input:focus {
  outline: none;
  border-color: var(--gold);
  background: var(--glass-hover);
}
.search-btn {
  position: absolute;
  right: 8px;
  top: 50%;
  transform: translateY(-50%);
  background: var(--gold);
  border: none;
  color: #fff;
  width: 38px;
  height: 38px;
  border-radius: 6px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.15s;
}
.search-btn:hover { background: var(--gold-light); }
.search-btn svg {
  width: 18px;
  height: 18px;
  stroke: #fff;
  fill: none;
  stroke-width: 2.5;
  stroke-linecap: round;
  stroke-linejoin: round;
}

/* ═══════════ ACTION BUTTONS ═══════════ */
.action-buttons {
  display: flex;
  gap: 12px;
  justify-content: center;
  flex-wrap: wrap;
  margin-bottom: 48px;
}
.btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 14px 28px;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  text-decoration: none;
  border-radius: 6px;
  transition: all 0.2s;
  font-family: inherit;
  border: none;
  cursor: pointer;
}
.btn-primary {
  background: var(--gold);
  color: #fff;
}
.btn-primary:hover {
  background: var(--gold-light);
  transform: translateY(-1px);
  box-shadow: 0 6px 20px rgba(240, 165, 0, 0.25);
}
.btn-secondary {
  background: transparent;
  color: #fff;
  border: 1.5px solid var(--border-soft);
}
.btn-secondary:hover {
  border-color: var(--gold);
  color: var(--gold-light);
  background: var(--glass);
}
.btn svg {
  width: 16px;
  height: 16px;
  stroke: currentColor;
  fill: none;
  stroke-width: 2;
  stroke-linecap: round;
  stroke-linejoin: round;
}

/* ═══════════ SUGGESTED LINKS ═══════════ */
.suggestions-label {
  font-size: 11px;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--text-muted);
  margin-bottom: 18px;
}
.suggestions {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
  margin-bottom: 40px;
}
.suggestion-card {
  background: var(--glass);
  border: 1px solid var(--border-soft);
  padding: 20px 16px;
  border-radius: 8px;
  text-decoration: none;
  color: #fff;
  transition: all 0.2s;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
}
.suggestion-card:hover {
  background: var(--glass-hover);
  border-color: var(--gold);
  transform: translateY(-2px);
}
.suggestion-icon {
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(240, 165, 0, 0.1);
  border-radius: 50%;
}
.suggestion-icon svg {
  width: 18px;
  height: 18px;
  stroke: var(--gold-light);
  fill: none;
  stroke-width: 2;
  stroke-linecap: round;
  stroke-linejoin: round;
}
.suggestion-name {
  font-size: 13px;
  font-weight: 500;
  color: #fff;
}
.suggestion-sub {
  font-size: 10px;
  color: var(--text-muted);
  letter-spacing: 1px;
  text-transform: uppercase;
}

/* ═══════════ PHONE CTA ═══════════ */
.phone-cta {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  padding: 14px 24px;
  background: rgba(240, 165, 0, 0.08);
  border: 1px solid var(--border-soft);
  border-radius: 8px;
  text-decoration: none;
  color: #fff;
  transition: all 0.2s;
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}
.phone-cta:hover {
  background: rgba(240, 165, 0, 0.15);
  border-color: var(--gold);
}
.phone-cta .phone-icon {
  width: 36px;
  height: 36px;
  background: var(--gold);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.phone-cta .phone-icon svg {
  width: 16px;
  height: 16px;
  stroke: #fff;
  fill: none;
  stroke-width: 2.5;
  stroke-linecap: round;
  stroke-linejoin: round;
}
.phone-cta .phone-content {
  text-align: left;
}
.phone-cta .phone-label {
  font-size: 10px;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--text-muted);
}
.phone-cta .phone-number {
  font-family: 'Playfair Display', serif;
  font-size: 18px;
  font-weight: 700;
  color: var(--gold-light);
  margin-top: 2px;
}

/* ═══════════ FOOTER ═══════════ */
footer {
  background: var(--navy-deep);
  border-top: 1px solid var(--border-soft);
  padding: 24px;
  text-align: center;
}
footer .copy {
  font-size: 12px;
  color: var(--text-muted);
  letter-spacing: 1px;
}
footer .copy strong {
  color: var(--gold-light);
  font-weight: 500;
}

/* ═══════════ MOBILE ═══════════ */
@media (max-width: 720px) {
  .suggestions {
    grid-template-columns: repeat(2, 1fr);
  }
  .nav-inner {
    padding: 0 18px;
    height: 60px;
  }
  .hero-404 {
    padding: 40px 18px 60px;
  }
  .nav-logo .sub {
    display: none;
  }
  .error-num {
    letter-spacing: -2px;
  }
  .action-buttons .btn {
    flex: 1;
    min-width: 140px;
    justify-content: center;
  }
  .phone-cta {
    width: 100%;
    justify-content: center;
  }
}

@media (max-width: 420px) {
  .suggestions {
    grid-template-columns: 1fr 1fr;
  }
  h1 {
    font-size: 22px;
  }
  .hero-text {
    font-size: 14px;
  }
}
</style>
</head>
<body>

